generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER ────────────────────────────────────────────────────────────────────

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     String // "faculty" | "student"
  name     String?
  rollNo   String? @unique
  prn      String? @unique
  deviceId String?
  deviceLocked Boolean @default(false)
  deviceChangedAt DateTime? // last time the student moved the account to another phone
  pushToken String?

  // Relations
  taughtSubjects  Subject[]    @relation("FacultySubjects")
  enrollments     Enrollment[]
  sessions        Session[]
  attendances     Attendance[]
  leaveRequests   LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
}

// ─── SUBJECT ─────────────────────────────────────────────────────────────────

model Subject {
  id        Int    @id @default(autoincrement())
  name      String
  code      String   // e.g. "CS301"
  facultyId Int
  type      String @default("theory") // "theory" or "practical"
  span      String? // semester or academic year, e.g. "Sem 5" or "2026-27" (optional label)

  faculty     User         @relation("FacultySubjects", fields: [facultyId], references: [id])
  enrollments   Enrollment[]
  sessions      Session[]
  leaveRequests LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, type])
}

// ─── ENROLLMENT ───────────────────────────────────────────────────────────────

model Enrollment {
  id        Int @id @default(autoincrement())
  studentId Int
  subjectId Int
  status    String @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"

  student User    @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  enrolledAt DateTime @default(now())

  @@unique([studentId, subjectId])
}

// ─── SESSION ─────────────────────────────────────────────────────────────────

model Session {
  id          Int     @id @default(autoincrement())
  subjectId   Int
  facultyId   Int
  correctCode String  // 4-digit code e.g. "4721"
  isActive    Boolean @default(true)

  startTime   DateTime  @default(now())
  windowExpiry DateTime?
  endTime     DateTime?

  // Scheduling fields
  date               DateTime? // New optional field
  scheduledStartTime String?   // Existing field
  scheduledEndTime   String?   // Existing field
  status             String?   @default("active") // New optional field

  subject     Subject      @relation(fields: [subjectId], references: [id])
  faculty     User         @relation(fields: [facultyId], references: [id])
  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ATTENDANCE ───────────────────────────────────────────────────────────────

model Attendance {
  id          Int    @id @default(autoincrement())
  sessionId   Int
  studentId   Int
  status      String // "PRESENT" | "INVALID" | "ABSENT"
  reason      String? // reason for INVALID/ABSENT

  // Student submission data
  submittedCode String?
  deviceId      String?
  submittedAt   DateTime?
  editedByFaculty Boolean @default(false)

  session Session @relation(fields: [sessionId], references: [id])
  student User    @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId]) // one record per student per session
  @@index([studentId])
}

// ─── OTP ──────────────────────────────────────────────────────────────────────

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}


// ─── LEAVE REQUEST ───────────────────────────────────────────────────────────
// A student's request for time off in one subject. Approved leave turns the student's
// missed classes in that period into EXCUSED, which do not count against their percentage.

model LeaveRequest {
  id         Int       @id @default(autoincrement())
  studentId  Int
  subjectId  Int
  fromDate   String    // first day of leave, "YYYY-MM-DD" in the college's time zone
  toDate     String    // last day of leave (inclusive)
  reason     String
  status     String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  reviewNote String?
  reviewedAt DateTime?

  student User    @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId, status])
  @@index([studentId])
}
